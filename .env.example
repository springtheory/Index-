# OpenAI API Key (required for voice transcription and AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Twilio credentials (required for WhatsApp integration)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# JWT Secret (required - generate a random string: openssl rand -hex 32)
JWT_SECRET=your-random-secret-here-change-this

# Server config
PORT=3001
NODE_ENV=development

# CORS origin for production (optional)
# CORS_ORIGIN=https://your-domain.com

# Max voice note duration in minutes (default: 120 = 2 hours)
MAX_VOICE_DURATION_MINUTES=120
