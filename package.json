{
  "name": "index-inventory",
  "version": "1.0.0",
  "description": "AI-powered garage & home inventory management system",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx vite build",
    "start": "NODE_ENV=production node server/index.js",
    "db:reset": "node server/db/reset.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "twilio": "^5.4.3",
    "uuid": "^11.0.3"
  }
}
